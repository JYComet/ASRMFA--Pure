# Python
__pycache__/
.pytest_cache/
*.pyc
*.pyo

# Workspace outputs (generated)
workspace/
workspace_*/
output/
output_*/
filtered/
aligned/
validate/
temp/
ctc_pretg/
ctc_pretg_adj/
ctc_adjusted/
audio/
audio_16k/
pinyin/
*.TextGrid
*.lab
*_tokens.jsonl
*_punct.json
manifest.json
summary.txt
postprocess_report.jsonl
tone_mapping.json

# Large model files (downloaded separately).
# MFA pretrained zips and their extracted trees are fetched by
# scripts/download_models.py; Qwen3 weights likewise.  Nothing under these
# paths belongs in git.
models/Multilingual-NVASR/
models/mfa/pretrained_models/
models/mfa/extracted_models/
models/qwen3/

# Project data (user-provided)
data_dir/
test_data/
cache/

# MFA runtime (under MFA_ROOT_DIR, regenerated by every run)
models/mfa/command_history.yaml
models/mfa/global_config.yaml
models/mfa/joblib_cache/
models/mfa/temp/
models/mfa/corpus/
models/mfa/en_oov_words/
models/mfa/test_oov/

# Run logs and progress markers
logs/
*.log
*.pid
*.status

# Dictionary transaction artifacts.  The atomically-committed pair is
# dict/<name> + its .candidate-<pid> next to it; .previous-<pid> is the
# pre-merge backup and .FAILED-<pid> is quarantine.  None are inputs.
dict/.*.previous-*
dict/.*.candidate-*
dict/.*.FAILED-*

# Conda environment
.env/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
